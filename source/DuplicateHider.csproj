<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <ProjectGuid>{4FDF1E89-5BC3-4C72-8FDA-0D580E7A5D5F}</ProjectGuid>
    <OutputType>Library</OutputType>
    <AppDesignerFolder>Properties</AppDesignerFolder>
    <RootNamespace>DuplicateHider</RootNamespace>
    <AssemblyName>DuplicateHider</AssemblyName>
    <TargetFramework>net462</TargetFramework>
    <UseWpf>true</UseWpf>
    <Deterministic>true</Deterministic>
    <!-- Keep existing AssemblyInfo.cs; disable auto-generated assembly attributes -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|AnyCPU'">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|AnyCPU'">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <!-- Exclude backup folder from auto-glob -->
  <ItemGroup>
    <Compile Remove="MigrationBackup\**" />
    <Page Remove="MigrationBackup\**" />
    <None Remove="MigrationBackup\**" />
  </ItemGroup>

  <!-- Local SDK references (not on NuGet) -->
  <ItemGroup>
    <Reference Include="QuickSearchSDK">
      <HintPath>..\..\QuickSearch\source\bin\Release\QuickSearchSDK.dll</HintPath>
    </Reference>
    <Reference Include="QuickSearchSDK.Attributes">
      <HintPath>..\..\QuickSearch\source\bin\Release\QuickSearchSDK.Attributes.dll</HintPath>
    </Reference>
    <Reference Include="StartPage.SDK">
      <HintPath>..\..\StartPage-for-Playnite\source\StartPage.SDK\bin\Release\StartPage.SDK.dll</HintPath>
    </Reference>
  </ItemGroup>
  <!-- NuGet packages -->
  <ItemGroup>
    <!-- Plugin-eigene Abhängigkeit: wird in den Plugin-Output kopiert -->
    <PackageReference Include="gong-wpf-dragdrop" Version="4.0.0" />
    <!-- Playnite liefert diese Assemblies selbst mit → ExcludeAssets="runtime"
         verhindert, dass sie in den Plugin-Output kopiert werden (dev guide). -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="PlayniteSDK" Version="6.16.0">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Localization files must be Content (copied to output), not compiled XAML Pages -->
  <ItemGroup>
    <Page Remove="Localization\**" />
    <Content Include="Localization\*.xaml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Icon resources embedded in the assembly -->
  <ItemGroup>
    <Resource Include="icons\*.ico" />
  </ItemGroup>

  <!-- Files to copy to output directory -->
  <ItemGroup>
    <None Update="extension.yaml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="icon.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <PropertyGroup>
    <PostBuildEvent>%25LOCALAPPDATA%25\Playnite\Toolbox.exe pack $(ProjectDir)$(OutDir) $(ProjectDir)bin</PostBuildEvent>
  </PropertyGroup>
</Project>